# REDACTED TEMPLATE — variable names copied from the real job-mobile/.env; every value
# below is a placeholder. The real .env (and the .jks keystores / credentials.json /
# google-services.json in that folder) were NOT copied here.

# RevenueCat — platform SDK keys for in-app purchases
REVENUECAT_ANDROID_KEY=goog_your-revenuecat-android-key
REVENUECAT_IOS_KEY=appl_your-revenuecat-ios-key

# Google Sign-In OAuth client IDs (per platform)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
