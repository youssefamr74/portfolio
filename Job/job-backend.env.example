# REDACTED TEMPLATE — variable names copied from job-backend/config.py and the real
# job-backend/.env; every value below is a placeholder. The real .env was NOT copied here.

# App
APP_ENV=development
APP_NAME=Jōb
APP_VERSION=0.1.0

# Database (async SQLAlchemy — note the +asyncpg driver prefix)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/job

# Google OAuth (Gmail sync + Google Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Supabase (Postgres hosting + auth/JWT verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_PUBLIC_KEY=your-supabase-jwt-public-key

# CORS — comma/JSON-list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# Anthropic Claude — used for email classification + companion messages
ANTHROPIC_API_KEY=sk-ant-your-api-key

# RevenueCat — verifies subscription webhook payloads
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# Public URL this backend is reachable at (used for building links, webhooks, etc.)
BACKEND_URL=http://localhost:8000

# Resend — transactional email (support flow)
RESEND_API_KEY=your-resend-api-key
SUPPORT_EMAIL=support@example.com
