# REDACTED TEMPLATE — variable names copied from what docker-compose.prod.yml / Jenkinsfile
# actually reference. In the real project the Postgres user/password are hardcoded dev
# defaults directly in the compose files (not in an actual .env file) — this template exists
# to show what SHOULD be externalized for a real production deployment rather than to redact
# an existing secret.

# AWS ECR registry the prod compose file pulls service images from
REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# Postgres credentials shared by all backend services (isolated DBs: user_db, order_db, trade_db)
DB_USER=postgres
DB_PASSWORD=change-me-in-production

# AWS credentials for Terraform / ECR push — never commit real values, use your shell env or
# a secrets manager (Jenkins credentials store, AWS SSM, etc.) instead
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
